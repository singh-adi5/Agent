{
  "cases": [
    {
      "name": "non-DC account replicates directory changes",
      "expect": "fire",
      "assert": {"Actor": "labadmin", "SourceIp": "10.10.1.10"},
      "events": [
        {"age_minutes": 5, "EventID": 4662, "ObjectServer": "DS", "SubjectUserName": "labadmin", "SubjectDomainName": "CONTOSO", "SubjectLogonId": "0x3e7abc", "Properties": "... 1131f6ad-9c07-11d1-f79f-00c04fc2dcd2 ..."},
        {"age_minutes": 6, "EventID": 4624, "LogonType": 3, "Computer": "", "TargetLogonId": "0x3e7abc", "IpAddress": "10.10.1.10"}
      ]
    },
    {
      "name": "source address comes from the most recent logon with that logon ID",
      "expect": "fire",
      "assert": {"SourceIp": "10.10.1.10"},
      "events": [
        {"age_minutes": 5, "EventID": 4662, "ObjectServer": "DS", "SubjectUserName": "labadmin", "SubjectDomainName": "CONTOSO", "SubjectLogonId": "0x5a1f2", "Properties": "... 1131f6ad-9c07-11d1-f79f-00c04fc2dcd2 ..."},
        {"age_minutes": 50, "EventID": 4624, "LogonType": 3, "TargetLogonId": "0x5a1f2", "IpAddress": "10.10.1.99"},
        {"age_minutes": 6, "EventID": 4624, "LogonType": 3, "TargetLogonId": "0x5a1f2", "IpAddress": "::ffff:10.10.1.10"}
      ]
    },
    {
      "name": "source address comes from the most recent logon with that logon ID",
      "expect": "fire",
      "assert": {"SourceIp": "10.10.1.10"},
      "events": [
        {"age_minutes": 5, "EventID": 4662, "ObjectServer": "DS", "SubjectUserName": "labadmin", "SubjectDomainName": "CONTOSO", "SubjectLogonId": "0x5a1f2", "Properties": "... 1131f6ad-9c07-11d1-f79f-00c04fc2dcd2 ..."},
        {"age_minutes": 50, "EventID": 4624, "LogonType": 3, "TargetLogonId": "0x5a1f2", "IpAddress": "10.10.1.99"},
        {"age_minutes": 6, "EventID": 4624, "LogonType": 3, "TargetLogonId": "0x5a1f2", "IpAddress": "::ffff:10.10.1.10"}
      ]
    },
    {
      "name": "source address comes from the most recent logon with that logon ID",
      "expect": "fire",
      "assert": {"SourceIp": "10.10.1.10"},
      "events": [
        {"age_minutes": 5, "EventID": 4662, "ObjectServer": "DS", "SubjectUserName": "labadmin", "SubjectDomainName": "CONTOSO", "SubjectLogonId": "0x5a1f2", "Properties": "... 1131f6ad-9c07-11d1-f79f-00c04fc2dcd2 ..."},
        {"age_minutes": 50, "EventID": 4624, "LogonType": 3, "TargetLogonId": "0x5a1f2", "IpAddress": "10.10.1.99"},
        {"age_minutes": 6, "EventID": 4624, "LogonType": 3, "TargetLogonId": "0x5a1f2", "IpAddress": "::ffff:10.10.1.10"}
      ]
    },
    {
      "name": "a real domain controller replicating is normal",
      "expect": "silent",
      "events": [
        {"age_minutes": 5, "EventID": 4662, "ObjectServer": "DS", "SubjectUserName": "DC01$", "SubjectDomainName": "CONTOSO", "SubjectLogonId": "0x3e4", "Properties": "... 1131f6ad-9c07-11d1-f79f-00c04fc2dcd2 ..."}
      ]
    },
    {
      "name": "non-DC directory access without a replication right",
      "expect": "silent",
      "events": [
        {"age_minutes": 5, "EventID": 4662, "ObjectServer": "DS", "SubjectUserName": "labadmin", "SubjectDomainName": "CONTOSO", "SubjectLogonId": "0x3e7", "Properties": "... some-other-guid-00000000-0000 ..."}
      ]
    },
