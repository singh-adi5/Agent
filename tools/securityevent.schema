# Columns of the SecurityEvent table used to analyse the queries offline.
# One "name: type" per line. This is a subset of the real table. Every entry was
# checked against the Azure Monitor Logs reference for SecurityEvent
# (MicrosoftDocs/azure-monitor-docs, reference/tables/securityevent.md).
# Add a column here only after confirming it is in that reference. Note that
# TicketEncryptionType and TicketOptions are NOT columns: read them from EventData.
TimeGenerated: datetime
Computer: string
EventID: int
Activity: string
Account: string
AccountType: string
EventData: string
TargetUserName: string
TargetDomainName: string
TargetAccount: string
TargetLogonId: string
SubjectUserName: string
SubjectDomainName: string
SubjectAccount: string
SubjectLogonId: string
SubjectUserSid: string
IpAddress: string
IpPort: string
LogonType: int
Status: string
SubStatus: string
ServiceName: string
ObjectServer: string
ObjectName: string
ObjectType: string
Properties: string
OperationType: string
AccessMask: string
WorkstationName: string
